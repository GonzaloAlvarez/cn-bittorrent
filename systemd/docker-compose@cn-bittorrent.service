[Unit]
Description=cn-bittorrent docker compose stack (mullvad-egress torrent core)
# Hard ordering: don't even try until the NFS share is mounted + docker is up.
Requires=docker.service home-gonzalo-docker-data-nfs.mount
After=docker.service home-gonzalo-docker-data-nfs.mount network-online.target
RequiresMountsFor=/home/gonzalo/docker/data/nfs
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=gonzalo
Group=gonzalo
WorkingDirectory=/home/gonzalo/cn-bittorrent
# Belt-and-suspenders pre-checks: bail BEFORE docker compose ever sees
# the bind sources if the mount or the torrent/ subtree is missing.
ExecStartPre=/usr/bin/mountpoint -q /home/gonzalo/docker/data/nfs
ExecStartPre=/usr/bin/test -d /home/gonzalo/docker/data/nfs/torrent
ExecStart=/usr/bin/docker compose -p cn-bittorrent up -d --remove-orphans
ExecStop=/usr/bin/docker compose -p cn-bittorrent down

[Install]
WantedBy=multi-user.target
